# ======================================================================
# Root Environment Variables for the Entire Project
#
# Instructions:
# 1. Copy this file to .env (in the project root).
# 2. Fill in the necessary values for your environment.
# 3. The root .env file should be in .gitignore and NOT committed.
# ======================================================================

# --- Common Configuration (Shared across multiple components) ---
COMMON_GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
COMMON_GOOGLE_CLOUD_PROJECT_NUMBER="your-gcp-project-number"
COMMON_DEFAULT_COMPUTE_SERVICE_ACCOUNT="your-project-number-compute@developer.gserviceaccount.com"
COMMON_VERTEX_STAGING_BUCKET="gs://your-gcp-project-id-adk-staging-bucket" # Used by deploy_all.py for ADK deployments
COMMON_GOOGLE_CLOUD_LOCATION="us-central1"
COMMON_SPANNER_INSTANCE_ID="instavibe-graph-instance"
COMMON_SPANNER_DATABASE_ID="graphdb"

# --- Instavibe Application (instavibe/app.py) ---
INSTAVIBE_FLASK_SECRET_KEY="a-very-strong-and-unique-secret-key-please-change"
INSTAVIBE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_OR_LEAVE_BLANK_IF_UNUSED"
INSTAVIBE_GOOGLE_MAPS_MAP_ID="YOUR_GOOGLE_MAPS_MAP_ID_OR_LEAVE_BLANK_IF_UNUSED"
# For Flask local development server (app.run()):
INSTAVIBE_APP_HOST="0.0.0.0"
INSTAVIBE_APP_PORT="8080" # Default local port for instavibe app

# --- Instavibe Workflow Agent (agents/instavibe_workflow/) ---
# These are used by deploy_all.py when deploying the workflow agent.
# This ID MUST use underscores_not_hyphens for compatibility with some SDK layers (e.g., Pydantic validation).
WORKFLOW_AGENT_ENGINE_ID="instavibe_workflow_agent" # Desired Reasoning Engine ID (use underscores)
WORKFLOW_AGENT_DISPLAY_NAME="Instavibe Workflow Agent" # Desired display name (can have spaces/hyphens)
# Note: The actual WORKFLOW_AGENT_URL is dynamically generated by deploy_all.py and passed to instavibe-app.
# If skipping workflow agent deployment in deploy_all.py but deploying instavibe-app,
# set WORKFLOW_AGENT_URL here if it's already deployed and known:
# WORKFLOW_AGENT_URL="previously-deployed-workflow-agent-url"


# --- Agent: Orchestrate (agents/orchestrate/) ---
# Configuration for the agent's own model (if it uses one directly)
AGENTS_ORCHESTRATE_GOOGLE_GENAI_USE_VERTEXAI="TRUE"
# Note: AGENTS_ORCHESTRATE_REMOTE_AGENT_ADDRESSES is dynamically set by deploy_all.py.

# --- Agent: Planner (agents/planner/) ---
# Configuration for the agent's own model
AGENTS_PLANNER_GOOGLE_GENAI_USE_VERTEXAI="TRUE"
AGENTS_PLANNER_GOOGLE_API_KEY="" # Optional: if Planner Agent uses a specific API key directly
# For local A2A communication if running agents locally (not via Agent Engine)
AGENTS_PLANNER_A2A_HOST="localhost"
AGENTS_PLANNER_A2A_PORT="10003"
# Note: The deployed resource name (AGENTS_PLANNER_RESOURCE_NAME) is dynamically generated by deploy_all.py
# and passed to the InstavibeWorkflowAgent if it needs to call this Planner agent.

# --- Agent: Platform MCP Client (agents/platform_mcp_client/) ---
AGENTS_PLATFORM_MCP_CLIENT_GOOGLE_GENAI_USE_VERTEXAI="TRUE"
AGENTS_PLATFORM_MCP_CLIENT_GOOGLE_API_KEY="" # Optional
AGENTS_PLATFORM_MCP_CLIENT_A2A_HOST="localhost"
AGENTS_PLATFORM_MCP_CLIENT_A2A_PORT="10002"
AGENTS_PLATFORM_MCP_CLIENT_MCP_SERVER_URL="" # Set this to the deployed URL of your mcp-tool-server
# Note: The deployed resource name (AGENTS_PLATFORM_MCP_CLIENT_RESOURCE_NAME) is dynamically generated by deploy_all.py.

# --- Agent: Social (agents/social/) ---
AGENTS_SOCIAL_GOOGLE_GENAI_USE_VERTEXAI="TRUE"
AGENTS_SOCIAL_GOOGLE_API_KEY="" # Optional
AGENTS_SOCIAL_A2A_HOST="localhost"
AGENTS_SOCIAL_A2A_PORT="10001"
# Note: The deployed resource name (AGENTS_SOCIAL_RESOURCE_NAME) is dynamically generated by deploy_all.py.
# Spanner config (COMMON_SPANNER_INSTANCE_ID, COMMON_SPANNER_DATABASE_ID) is used by Social Agent.

# --- Tools Configurations (tools/instavibe/mcp_server.py) ---
# These are for the MCP Tool Server if it uses an LLM directly.
TOOLS_GOOGLE_GENAI_USE_VERTEXAI="TRUE"
TOOLS_GOOGLE_API_KEY="" # Optional, if tools use a specific API key for their LLM calls
# TOOLS_INSTAVIBE_BASE_URL is the URL for the Instavibe API (instavibe-app).
# For local development, if instavibe-app runs on port 8080:
TOOLS_INSTAVIBE_BASE_URL="http://localhost:8080/api"
# If mcp-tool-server is deployed, deploy_all.py should pass the dynamic instavibe-app URL to it if needed.


# --- Variables primarily for local development or if skipping parts of deploy_all.py ---
# These are dynamically generated and set by deploy_all.py for deployed components.
# Only set them here if you are running components locally or have pre-deployed services
# and are skipping their deployment in deploy_all.py.

# AGENTS_PLANNER_RESOURCE_NAME="projects/your-gcp-project-id/locations/us-central1/reasoningEngines/your-planner-id"
# AGENTS_SOCIAL_RESOURCE_NAME="projects/your-gcp-project-id/locations/us-central1/reasoningEngines/your-social-id"
# AGENTS_PLATFORM_MCP_CLIENT_RESOURCE_NAME="projects/your-gcp-project-id/locations/us-central1/reasoningEngines/your-platform-mcp-client-id"
# AGENTS_ORCHESTRATE_RESOURCE_NAME="projects/your-gcp-project-id/locations/us-central1/reasoningEngines/your-orchestrate-id"

# MCP_TOOL_SERVER_URL="your-deployed-mcp-tool-server-url" # Needed by AGENTS_PLATFORM_MCP_CLIENT_MCP_SERVER_URL if mcp-tool-server is deployed separately.
# INSTAVIBE_APP_PUBLIC_URL="your-deployed-instavibe-app-url" # Needed by TOOLS_INSTAVIBE_BASE_URL if instavibe-app is deployed separately.
# (The TOOLS_INSTAVIBE_BASE_URL is for the mcp-tool-server to call the instavibe app's API)

# Note on *_A2A_HOST / *_A2A_PORT: These are typically for local agent-to-agent communication
# when not using the full Agent Engine deployment and discovery. They are less relevant
# when all agents are deployed on Agent Engine and discover/call each other via resource names.
# However, they might be used by agents if their internal logic supports such direct local calls for testing.
# The InstavibeWorkflowAgent, for example, now uses resource names passed by deploy_all.py.
# Other agents (Planner, Orchestrator) would also need to be refactored to accept resource names
# if they are to call each other when deployed on Agent Engine, or use a discovery mechanism if available.
# For now, their direct inter-dependencies are not explicitly configured via .env.example for deployed scenarios,
# beyond what Orchestrate Agent receives via AGENTS_ORCHESTRATE_REMOTE_AGENT_ADDRESSES.
# The InstavibeWorkflowAgent now centralizes some of this orchestration.
# The `deploy_all.py` script handles passing the necessary *deployed* resource names.
# This .env.example is primarily for setting up the *initial conditions* for `deploy_all.py`
# and for local development configurations.
[end of .env.example]
